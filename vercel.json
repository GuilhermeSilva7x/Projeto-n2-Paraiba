{
  "version": 2,
  "builds": [
    {
      "src": "src/servidor.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/servidor.js"
    },
    {
      "src": "/",
      "dest": "/ExtratorPDF.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}